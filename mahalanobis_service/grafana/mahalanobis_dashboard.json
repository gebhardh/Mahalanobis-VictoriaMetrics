{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "uid": "mahalanobis-anomalie",
  "title": "Mahalanobis-Anomalieerkennung",
  "description": "Ergebnisse von mahalanobis_service.py und analysierte Rohdaten",
  "tags": [
    "mahalanobis",
    "anomalie",
    "victoriametrics"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datenquelle",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Instanz",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mahalanobis_d, instance)",
          "refId": "instance"
        },
        "definition": "label_values(mahalanobis_d, instance)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Anomalien",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "rgba(242, 73, 92, 0.25)",
        "expr": "max by (instance) (mahalanobis_anomalie{instance=~\"$instance\"}) == 1",
        "target": {
          "expr": "max by (instance) (mahalanobis_anomalie{instance=~\"$instance\"}) == 1",
          "refId": "Anno",
          "interval": "1m"
        },
        "step": "1m",
        "titleFormat": "Anomalie",
        "textFormat": "{{instance}}",
        "tagKeys": "instance",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Übersicht",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Distanz / Schwelle (aktuell)",
      "description": "< 1: normal, ≥ 1: anomal, ≥ 2: stark anomal (letzter Wert der letzten 15 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 7,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(mahalanobis_d{instance=~\"$instance\"}[15m]) / last_over_time(mahalanobis_schwelle_d{instance=~\"$instance\"}[15m])",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Anomalie-Anteil letzte Stunde",
      "description": "Anteil der Messzeitpunkte der letzten Stunde, die als anomal bewertet wurden. Beim 99-%-Quantil sind ca. 1 % Fehlalarme normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 7,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(mahalanobis_anomalie{instance=~\"$instance\"}[1h])",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Häufigster Haupttreiber (1 h)",
      "description": "Merkmal, das in der letzten Stunde am häufigsten den größten Leave-one-out-Effekt hatte (Wert = Anzahl anomaler Minuten).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 13,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk by (instance) (1, sum by (instance, merkmal) (count_over_time(mahalanobis_haupttreiber{instance=~\"$instance\"}[1h])))",
          "legendFormat": "{{instance}}: {{merkmal}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "noValue": "keine Anomalie",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Service: letzter Lauf vor",
      "description": "Zeit seit dem letzten Lauf von mahalanobis_service.py (MetricsQL lag()).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(lag(mahalanobis_service_laufdauer_sekunden[1d]))",
          "legendFormat": "letzter Lauf",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "keine Daten",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service: Instanzen",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 19,
        "y": 4,
        "w": 5,
        "h": 2
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (last_over_time(mahalanobis_service_instanzen[1h]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fehler"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uebersprungen"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Zeitleiste: Distanz relativ zur Schwelle",
      "description": "Grün: normal, orange: anomal (D > Schwelle), rot: D ≥ 2× Schwelle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(mahalanobis_d{instance=~\"$instance\"}[$__interval]) / max_over_time(mahalanobis_schwelle_d{instance=~\"$instance\"}[$__interval])",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": false,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Analyse: $instance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "repeat": "instance"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mahalanobis-Distanz und Schwelle",
      "description": "Maximum der Distanz je Zeitintervall; Werte über der roten Linie sind anomal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(mahalanobis_d{instance=~\"$instance\"}[$__interval])",
          "legendFormat": "Distanz D",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(mahalanobis_schwelle_d{instance=~\"$instance\"}[$__interval])",
          "legendFormat": "Schwelle",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": 120000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Distanz D"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Schwelle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "status-history",
      "title": "|z| je Merkmal",
      "description": "Univariate Abweichung je Merkmal. Rot (|z| ≥ 3): Merkmal allein auffällig. Ist D anomal, aber alles grün/gelb, liegt ein Korrelationsbruch vor.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(abs(mahalanobis_z{instance=~\"$instance\"})[$__interval:])",
          "legendFormat": "{{merkmal}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "colWidth": 0.95,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "maxDataPoints": 100
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Beitrag zu D² je Merkmal",
      "description": "Additive Zerlegung: Die gestapelte Summe ergibt D². Negative Beiträge entstehen, wenn korrelierte Merkmale sich gegenseitig 'erklären'.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(mahalanobis_beitrag{instance=~\"$instance\"}[$__interval])",
          "legendFormat": "{{merkmal}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": 120000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": null
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Leave-one-out (aktuell)",
      "description": "Um wie viel D² sinkt, wenn das Merkmal weggelassen wird (letzter Wert).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(last_over_time(mahalanobis_loo{instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{merkmal}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Kennwerte je Merkmal (aktuell)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(mahalanobis_z{instance=~\"$instance\"}[15m])",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(mahalanobis_anteil{instance=~\"$instance\"}[15m])",
          "legendFormat": "",
          "refId": "B",
          "range": false,
